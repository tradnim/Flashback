# Local AI-VOICE service settings
HISTORICAL_ENGINE_URL=http://127.0.0.1:3000
HISTORICAL_ENGINE_TIME_PARAM=simulationTime
AI_VOICE_HOST=127.0.0.1
AI_VOICE_PORT=8000
AI_VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional browser-reachable base URL for generated audio. Leave blank to infer
# the browser host from Origin and use AI_VOICE_PORT. For LAN access, bind with
# AI_VOICE_HOST=0.0.0.0 and set this to http://<your-computer-LAN-IP>:8000.
AI_VOICE_PUBLIC_URL=

# ElevenLabs is used by the current radio briefing implementation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gemini on Google Cloud Agent Platform powers grounded historical answers.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
