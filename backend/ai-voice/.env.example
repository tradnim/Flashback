# Local AI-VOICE service settings
HISTORICAL_ENGINE_URL=http://127.0.0.1:3000
AI_VOICE_HOST=127.0.0.1
AI_VOICE_PORT=8000
AI_VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional public HTTP(S) base URL. Blank returns same-origin /api/audio/<token>.
AI_VOICE_PUBLIC_URL=

# ElevenLabs is used by the current radio briefing implementation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gemini on Google Cloud Agent Platform powers grounded historical answers.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Optional absolute path to a private Google credentials file, outside Git.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/google-credentials.json
