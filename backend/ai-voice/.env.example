# Local AI-VOICE service settings
HISTORICAL_ENGINE_URL=http://127.0.0.1:3000
HISTORICAL_ENGINE_TIME_PARAM=simulationTime
AI_VOICE_HOST=127.0.0.1
AI_VOICE_PORT=8000
AI_VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ElevenLabs is used by the current radio briefing implementation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# The checked-in /api/ask code still uses Gemini. Keep these commented until
# the team confirms whether Gemini remains the provider or is being replaced.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
